# cp .env.sample .env 로 복사한 뒤 값을 채웁니다. .env는 커밋하지 않습니다.
# 비워 두어도 앱은 돌아갑니다: Supabase가 없으면 로그인 없이 이 기기에만 저장, 공공데이터 키가 없으면 동네 시세만 안 나옵니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DATA_GO_KR_API_KEY=
# 선택: 공유 미리보기에 쓸 사이트 주소. Netlify에서는 자동(URL)이라 비워 둡니다. 없으면 http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# 개발할 때만: 근거 목록을 법령 원문과 대조 (국가법령정보 공동활용 Open API)
LAW_API_OC=
